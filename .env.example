# =============================================================================
# busy-api — Environment Variables
# Copy this file to .env and fill in the required values.
# .env is git-ignored; never commit secrets.
# Source of truth: docs/REQUIREMENTS.md §9
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# HTTP listen port
PORT=8000

# Deployment environment: local | staging | prod  (gates HSTS, docs, secret source)
ENV=local

# -----------------------------------------------------------------------------
# Database (Postgres via pgx)
# -----------------------------------------------------------------------------

# Required. Postgres DSN — e.g. postgres://user:pass@localhost:5432/busyapi?sslmode=disable
DATABASE_URL=

# Max pgxpool connections (default: 4×CPU cores at runtime)
DB_MAX_CONNS=

# DB call connect timeout in milliseconds
DB_CONN_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# Valkey / Redis
# -----------------------------------------------------------------------------

# Valkey (Redis-compatible) URL — empty string ⇒ in-memory fallback for all backends
VALKEY_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Emit JSON logs (true) or human-readable text (false)
LOG_JSON=true

# Optional file path for log rotation + gzip; empty ⇒ stdout only
LOG_FILE=

# Log file max size in MB before rotation
LOG_MAX_MB=10

# Number of rotated log backups to retain
LOG_BACKUP_COUNT=5

# -----------------------------------------------------------------------------
# HTTP Edge
# -----------------------------------------------------------------------------

# Maximum allowed request body in bytes (rejects with 413 when exceeded)
MAX_BODY_BYTES=1048576

# Comma-separated CORS allowed origins; empty ⇒ CORS middleware disabled
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# Resilience — Retry
# -----------------------------------------------------------------------------

# Maximum retry attempts for outbound calls
RETRY_MAX=3

# Base backoff delay in milliseconds (doubles per attempt with jitter)
RETRY_BASE_MS=200

# -----------------------------------------------------------------------------
# Resilience — Circuit Breaker
# -----------------------------------------------------------------------------

# Number of consecutive failures before the breaker opens
BREAKER_FAIL_THRESHOLD=5

# Seconds the breaker stays OPEN before transitioning to HALF_OPEN
BREAKER_RECOVERY_S=30

# -----------------------------------------------------------------------------
# Async API Audit Log
# -----------------------------------------------------------------------------

# Master switch — set false to disable all audit logging
APILOG_ENABLED=true

# Sink backend: postgres | queue
APILOG_SINK=postgres

# Bounded channel capacity; records are dropped (not blocked) when full
APILOG_BUFFER=10000

# Number of background drain goroutines
APILOG_WORKERS=2

# Flush to sink after accumulating this many records
APILOG_BATCH_SIZE=500

# Maximum milliseconds between flushes (timed flush, whichever fires first)
APILOG_FLUSH_MS=1000

# Fraction of 2xx responses to sample (0.0–1.0); non-2xx are always logged
APILOG_SAMPLE_2XX=0.1

# Capture sanitised request/response bodies in the audit record (false = off)
APILOG_CAPTURE_BODY=false

# Maximum bytes to capture from req/resp body (capped + sanitised via Sanitize())
APILOG_MAX_BODY_BYTES=4096

# Days to retain audit records (older daily partitions are dropped)
APILOG_TTL_DAYS=30

# -----------------------------------------------------------------------------
# OpenTelemetry
# -----------------------------------------------------------------------------

# Master switch — false ⇒ no exporters, stdout logs only (no Collector needed)
OTEL_ENABLED=true

# OTel resource service.name
OTEL_SERVICE_NAME=busy-api

# OTel resource service.version
OTEL_SERVICE_VERSION=dev

# OTLP gRPC endpoint for the OTel Collector
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Use plaintext (insecure) OTLP transport for local development
OTEL_EXPORTER_OTLP_INSECURE=true

# Trace sampler strategy
OTEL_TRACES_SAMPLER=parentbased_traceidratio

# Sampling ratio (0.0–1.0); use 1.0 for local dev, lower in prod
OTEL_TRACES_SAMPLER_ARG=0.1

# Metric export period in milliseconds
OTEL_METRIC_EXPORT_INTERVAL_MS=10000
